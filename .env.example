# ============================================================
# HotelPilot SaaS - Environment Variables
# ============================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hotelpilot?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_starter_monthly"
STRIPE_PRO_PRICE_ID="price_pro_monthly"
STRIPE_ENTERPRISE_PRICE_ID="price_enterprise_monthly"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HotelPilot"

# Email (optional - for notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@hotelpilot.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="HotelPilot <noreply@hotelpilot.com>"
